{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cornyhorse/forklift/schema-standards/20250826-fwf.json",
  "title": "Forklift FWF Row - Comprehensive Parquet Data Types",
  "description": "Schema for Fixed Width File processing demonstrating all supported Parquet data types with field positioning, alignment, padding, and data type validation for Parquet output.",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "age": { "type": "integer", "minimum": 0, "maximum": 150 },
    "salary": { "type": "number", "minimum": 0 },
    "is_active": { "type": "boolean" },
    "birth_date": { "type": "string", "format": "date" },
    "created_timestamp": { "type": "string", "format": "date-time" },
    "duration_seconds": { "type": "integer", "minimum": 0 },
    "score": { "type": "number", "multipleOf": 0.01 },
    "category": { "type": "string", "enum": ["A", "B", "C"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object", "additionalProperties": true },
    "binary_data": { "type": "string", "contentEncoding": "base64" },
    "uuid": { "type": "string", "format": "uuid" },
    "decimal_amount": { "type": "string", "pattern": "^\\d+\\.\\d{2}$" }
  },
  "required": ["id", "name"],
  "additionalProperties": false,

  "x-primaryKey": {
    "description": "Primary key configuration for data uniqueness and referential integrity",
    "columns": ["id"],
    "type": "single",
    "enforceUniqueness": true,
    "allowNulls": false,
    "description_detail": "Single column primary key on 'id' field ensuring row uniqueness"
  },

  "x-fwf": {
    "encoding": "utf-8",
    "trim": { "lstrip": false, "rstrip": true },
    "fields": [
      { "name": "id", "start": 1, "length": 10, "align": "right", "pad": " ", "parquetType": "int64" },
      { "name": "name", "start": 11, "length": 30, "align": "left", "pad": " ", "parquetType": "string" },
      { "name": "age", "start": 41, "length": 3, "align": "right", "pad": " ", "parquetType": "int32" },
      { "name": "salary", "start": 44, "length": 12, "align": "right", "pad": " ", "parquetType": "double" },
      { "name": "is_active", "start": 56, "length": 5, "align": "left", "pad": " ", "parquetType": "bool" },
      { "name": "birth_date", "start": 61, "length": 10, "align": "left", "pad": " ", "parquetType": "date32" },
      { "name": "created_timestamp", "start": 71, "length": 19, "align": "left", "pad": " ", "parquetType": "timestamp[us]" },
      { "name": "duration_seconds", "start": 90, "length": 8, "align": "right", "pad": " ", "parquetType": "duration[s]" },
      { "name": "score", "start": 98, "length": 8, "align": "right", "pad": " ", "parquetType": "float32" },
      { "name": "category", "start": 106, "length": 3, "align": "left", "pad": " ", "parquetType": "dictionary<values=string, indices=int32>" },
      { "name": "tags", "start": 109, "length": 100, "align": "left", "pad": " ", "parquetType": "list<string>" },
      { "name": "metadata", "start": 209, "length": 200, "align": "left", "pad": " ", "parquetType": "struct" },
      { "name": "binary_data", "start": 409, "length": 100, "align": "left", "pad": " ", "parquetType": "binary" },
      { "name": "uuid", "start": 509, "length": 36, "align": "left", "pad": " ", "parquetType": "string" },
      { "name": "decimal_amount", "start": 545, "length": 15, "align": "right", "pad": " ", "parquetType": "decimal128(10,2)" }
    ],
    "nulls": {
      "global": ["", "NULL", "N/A"],
      "perColumn": {
        "salary": ["", "          "],
        "tags": ["", "[]"],
        "metadata": ["", "{}"]
      }
    },
    "footer": { "mode": "regex", "pattern": "^(TOTAL|SUMMARY)\\b" }
  },

  "x-pii": {
    "description": "Personally Identifiable Information (PII) field marking for data privacy and masking applications",
    "fields": {
      "name": {
        "isPII": true,
        "category": "direct_identifier",
        "description": "Full name is direct PII requiring masking",
        "fieldPosition": { "start": 11, "length": 30 }
      },
      "birth_date": {
        "isPII": true,
        "category": "quasi_identifier",
        "description": "Birth date can be used to identify individuals when combined with other data",
        "fieldPosition": { "start": 61, "length": 10 }
      },
      "salary": {
        "isPII": true,
        "category": "sensitive",
        "description": "Financial information requiring protection",
        "fieldPosition": { "start": 44, "length": 12 }
      },
      "uuid": {
        "isPII": false,
        "category": "identifier",
        "description": "System-generated UUID, not personally identifying but may link records",
        "fieldPosition": { "start": 509, "length": 36 }
      }
    },
    "maskingRules": {
      "direct_identifier": {
        "method": "hash",
        "preserveFormat": false,
        "description": "Hash direct identifiers to protect individual privacy"
      },
      "quasi_identifier": {
        "method": "generalize",
        "preserveFormat": true,
        "description": "Generalize quasi-identifiers (e.g., birth year only)"
      },
      "sensitive": {
        "method": "range",
        "preserveFormat": true,
        "description": "Replace with ranges or categories to maintain utility while protecting privacy"
      }
    }
  },

  "x-calculatedColumns": {
    "description": "Configuration for adding calculated columns including constants, expressions, and computed fields",
    "constants": [
      {
        "name": "data_source",
        "value": "fwf_import",
        "dataType": "string",
        "description": "Source identifier for data lineage and partitioning"
      },
      {
        "name": "load_date",
        "value": "2024-08-26",
        "dataType": "date32",
        "description": "Date when data was loaded for temporal partitioning"
      },
      {
        "name": "record_type",
        "value": "fixed_width",
        "dataType": "string",
        "description": "Record type identifier for processing pipeline tracking"
      }
    ],
    "expressions": [
      {
        "name": "full_record_id",
        "expression": "record_id + '_' + record_type",
        "dataType": "string",
        "dependencies": ["record_id"],
        "description": "Composite record identifier with type prefix"
      },
      {
        "name": "status_category",
        "expression": "CASE WHEN status = 'A' THEN 'active' WHEN status = 'I' THEN 'inactive' ELSE 'unknown' END",
        "dataType": "string",
        "dependencies": ["status"],
        "description": "Human-readable status categorization"
      }
    ],
    "calculated": [
      {
        "name": "record_length",
        "function": "string_length",
        "dependencies": ["raw_record"],
        "dataType": "int32",
        "description": "Length of the raw fixed-width record"
      }
    ],
    "partitionColumns": ["data_source", "load_date", "record_type"],
    "indexColumns": ["record_id", "status"],
    "options": {
      "skipIfExists": false,
      "validateDependencies": true,
      "allowNullDependencies": false
    }
  },

  "x-transformations": {
    "description": "Data transformation and standardization configuration for fixed-width file processing with position-aware data cleaning",
    "stringCleaning": {
      "description": "String cleaning and normalization options for fixed-width field data",
      "normalizeQuotes": true,
      "normalizeDashes": true,
      "normalizeSpaces": true,
      "collapseWhitespace": true,
      "stripWhitespace": true,
      "removeZeroWidth": true,
      "removeControlChars": true,
      "preserveNewlines": false,
      "unicodeNormalize": "NFKC",
      "fwfSpecific": {
        "respectFieldBoundaries": true,
        "trimPaddingChars": true,
        "paddingChar": " ",
        "preserveLeadingZeros": true
      }
    },
    "caseTransformation": {
      "description": "Case normalization and transformation options for fixed-width text fields",
      "caseTransform": "upper",
      "fixCaseIssues": true,
      "titleCaseExceptions": ["of", "the", "and", "or", "but", "in", "on", "at", "to", "for", "with"],
      "customCaseMappings": {
        "ca": "CA",
        "ny": "NY",
        "tx": "TX",
        "usa": "USA",
        "uk": "UK"
      },
      "caseMappingMode": "exact"
    },
    "numericCleaning": {
      "description": "Numeric field cleaning and standardization for fixed-width numeric data",
      "thousandsSeparator": "",
      "decimalSeparator": ".",
      "allowNaN": true,
      "nanValues": ["", "NULL", "N/A", "9999", "0000"],
      "stripWhitespace": true,
      "fwfSpecific": {
        "paddedWithZeros": true,
        "signedFormat": "leading",
        "impliedDecimal": false,
        "decimalPlaces": 2
      }
    },
    "moneyType": {
      "description": "Currency and monetary value cleaning for fixed-width financial fields",
      "currencySymbols": [],
      "thousandsSeparator": "",
      "decimalSeparator": "",
      "parenthesesNegative": false,
      "stripWhitespace": true,
      "fwfSpecific": {
        "impliedDecimal": true,
        "decimalPlaces": 2,
        "signPosition": "trailing",
        "paddedFormat": true
      }
    },
    "dateTimeParsing": {
      "description": "DateTime parsing and standardization for fixed-width date fields",
      "mode": "specify_formats",
      "allowFuzzy": false,
      "fromEpoch": false,
      "targetType": "date",
      "fwfSpecific": {
        "fixedFormat": true,
        "centuryHandling": "windowing",
        "centuryWindow": 50,
        "julianDates": false
      },
      "formats": [
        "%Y%m%d",
        "%m%d%Y",
        "%d%m%Y",
        "%y%m%d",
        "%Y%j"
      ]
    },
    "fieldSpecific": {
      "id": {
        "transformations": ["numericCleaning"],
        "fieldPosition": { "start": 1, "length": 10 },
        "alignment": "right",
        "paddingChar": "0"
      },
      "name": {
        "transformations": ["stringCleaning", "caseTransformation"],
        "fieldPosition": { "start": 11, "length": 30 },
        "alignment": "left",
        "paddingChar": " "
      },
      "salary": {
        "transformations": ["moneyType", "numericCleaning"],
        "fieldPosition": { "start": 44, "length": 12 },
        "alignment": "right",
        "paddingChar": "0"
      },
      "birth_date": {
        "transformations": ["dateTimeParsing"],
        "fieldPosition": { "start": 61, "length": 10 },
        "dateFormat": "%Y%m%d"
      }
    }
  },

  "x-columnMapping": {
    "description": "Column name mapping and standardization configuration for fixed-width files",
    "explicitMappings": {
      "EMP_ID": "employee_id",
      "FNAME": "first_name",
      "LNAME": "last_name",
      "DOB": "birth_date",
      "SSN": "social_security_number",
      "ADDR": "address",
      "CITY": "city",
      "ST": "state",
      "ZIP": "zip_code",
      "PHONE": "phone_number",
      "EMAIL": "email_address",
      "HIRE_DT": "hire_date",
      "DEPT": "department",
      "POS": "position",
      "SAL": "salary"
    },
    "namingConvention": "snake_case",
    "caseSensitive": false,
    "allowUnmapped": true,
    "dropUnmapped": false,
    "fwfSpecific": {
      "fieldBoundaries": true,
      "preserveFieldOrder": true,
      "handleOverflow": "truncate"
    },
    "standardizationRules": {
      "removeSpecialChars": true,
      "replaceSpaces": "_",
      "maxLength": 64,
      "reservedWords": ["index", "table", "column", "select", "from", "where"],
      "reservedWordPrefix": "col_"
    }
  },

  "x-dataQuality": {
    "description": "Data quality validation and metrics configuration for fixed-width file data",
    "completeness": {
      "enabled": true,
      "requiredFields": ["id", "name"],
      "minimumFillRate": 0.95,
      "reportMissingValues": true,
      "fwfSpecific": {
        "checkFieldBoundaries": true,
        "validateRecordLength": true,
        "handleShortRecords": "pad",
        "handleLongRecords": "truncate"
      }
    },
    "uniqueness": {
      "enabled": true,
      "uniqueFields": ["id"],
      "allowDuplicates": false,
      "duplicateHandling": "error"
    },
    "consistency": {
      "enabled": true,
      "dataTypeValidation": true,
      "formatValidation": true,
      "rangeValidation": true,
      "fwfSpecific": {
        "validateFieldAlignment": true,
        "checkPaddingConsistency": true
      }
    },
    "accuracy": {
      "enabled": true,
      "emailValidation": false,
      "phoneValidation": true,
      "dateValidation": true,
      "numericValidation": true
    },
    "fieldSpecificRules": {
      "id": {
        "min": 1,
        "max": 9999999999,
        "dataType": "integer",
        "fieldPosition": { "start": 1, "length": 10 },
        "paddingValidation": true
      },
      "salary": {
        "min": 0,
        "max": 99999999,
        "dataType": "number",
        "fieldPosition": { "start": 44, "length": 12 },
        "impliedDecimal": true,
        "decimalPlaces": 2
      },
      "birth_date": {
        "format": "%Y%m%d",
        "minDate": "1900-01-01",
        "maxDate": "2100-12-31",
        "fieldPosition": { "start": 61, "length": 10 }
      }
    }
  }

}