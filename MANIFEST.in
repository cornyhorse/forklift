include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml
recursive-include src *.py
recursive-include docs *.md
recursive-include examples *.py
recursive-include schema-standards *.json *.md
prune tests
prune htmlcov
prune __pycache__
prune .pytest_cache
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude .DS_Store

