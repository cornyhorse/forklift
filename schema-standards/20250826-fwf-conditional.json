{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cornyhorse/forklift/schema-standards/20250826-fwf-conditional.json",
  "title": "Forklift FWF Row - Conditional Schema Support",
  "description": "Enhanced schema for Fixed Width File processing with conditional schema support based on flag columns. Allows different field layouts depending on flag values.",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "age": { "type": "integer", "minimum": 0, "maximum": 150 },
    "salary": { "type": "number", "minimum": 0 },
    "is_active": { "type": "boolean" },
    "birth_date": { "type": "string", "format": "date" },
    "foo": { "type": "string" },
    "bar": { "type": "integer" },
    "baz": { "type": "string" }
  },
  "required": ["id"],
  "additionalProperties": false,

  "x-metadata-generation": {
    "description": "Configuration for metadata file generation during processing",
    "enabled": true,
    "output_path": "auto",
    "enum_detection": {
      "enabled": true,
      "uniqueness_threshold": 0.1,
      "max_distinct_values": 50
    },
    "statistics": {
      "numeric": {
        "enabled": true,
        "include_quantiles": true,
        "quantiles": [0.25, 0.5, 0.75, 0.9, 0.95, 0.99],
        "include_outlier_detection": true
      },
      "string": {
        "enabled": true,
        "include_length_stats": true,
        "include_pattern_analysis": true
      },
      "categorical": {
        "enabled": true,
        "top_n_values": 10,
        "include_frequency_analysis": true
      }
    },
    "performance": {
      "skip_if_too_large": true,
      "max_rows_for_full_analysis": 1000000,
      "sample_size_for_large_files": 10000
    }
  },

  "x-primaryKey": {
    "description": "Primary key configuration for data uniqueness and referential integrity",
    "columns": ["id"],
    "type": "single",
    "enforceUniqueness": true,
    "allowNulls": false,
    "description_detail": "Single column primary key on 'id' field ensuring row uniqueness across all conditional schemas"
  },

  "x-rowHash": {
    "description": "Configuration for generating row-level hash columns for change detection and data integrity",
    "enabled": false,
    "columnName": "row_hash",
    "algorithm": "sha256",
    "includeColumns": null,
    "excludeColumns": [],
    "nullValue": "NULL",
    "separator": "||",
    "description_detail": "Row hash disabled by default. When enabled, generates SHA256 hash of all row data for change detection and integrity verification. Supports MD5, SHA1, SHA256, SHA384, SHA512 algorithms."
  },

  "x-fwf": {
    "encoding": "utf-8",
    "trim": { "lstrip": false, "rstrip": true },
    "conditionalSchemas": {
      "flagColumn": {
        "name": "record_type",
        "start": 1,
        "length": 1,
        "parquetType": "string"
      },
      "schemas": [
        {
          "flagValue": "F",
          "description": "Format F: Standard employee record",
          "fields": [
            { "name": "record_type", "start": 1, "length": 1, "align": "left", "pad": " ", "parquetType": "string" },
            { "name": "id", "start": 4, "length": 3, "align": "right", "pad": "0", "parquetType": "int64" },
            { "name": "foo", "start": 7, "length": 4, "align": "left", "pad": " ", "parquetType": "string" },
            { "name": "baz", "start": 11, "length": 5, "align": "left", "pad": " ", "parquetType": "string" }
          ]
        },
        {
          "flagValue": "G",
          "description": "Format G: Compact employee record",
          "fields": [
            { "name": "record_type", "start": 1, "length": 1, "align": "left", "pad": " ", "parquetType": "string" },
            { "name": "id", "start": 4, "length": 2, "align": "right", "pad": "0", "parquetType": "int64" },
            { "name": "foo", "start": 6, "length": 2, "align": "left", "pad": " ", "parquetType": "string" },
            { "name": "bar", "start": 8, "length": 3, "align": "right", "pad": "0", "parquetType": "int32" }
          ]
        }
      ]
    },
    "nulls": {
      "global": ["", "NULL", "N/A"],
      "perColumn": {
        "salary": ["", "          "],
        "foo": ["", "    "],
        "baz": ["", "     "]
      }
    },
    "footer": { "mode": "regex", "pattern": "^(TOTAL|SUMMARY)\\b" }
  },

  "x-pii": {
    "description": "Personally Identifiable Information (PII) field marking for data privacy and masking applications with conditional schema support",
    "fields": {
      "id": {
        "isPII": true,
        "category": "direct_identifier",
        "description": "Employee ID is direct PII requiring masking",
        "conditionalPositions": {
          "F": { "start": 4, "length": 3 },
          "G": { "start": 4, "length": 2 }
        }
      },
      "foo": {
        "isPII": true,
        "category": "quasi_identifier",
        "description": "Field foo may contain identifying information",
        "conditionalPositions": {
          "F": { "start": 7, "length": 4 },
          "G": { "start": 6, "length": 2 }
        }
      },
      "bar": {
        "isPII": false,
        "category": "identifier",
        "description": "Numeric identifier, not personally identifying",
        "conditionalPositions": {
          "G": { "start": 8, "length": 3 }
        }
      },
      "baz": {
        "isPII": true,
        "category": "sensitive",
        "description": "Field baz contains sensitive information",
        "conditionalPositions": {
          "F": { "start": 11, "length": 5 }
        }
      }
    },
    "maskingRules": {
      "direct_identifier": {
        "method": "hash",
        "preserveFormat": false,
        "description": "Hash direct identifiers to protect individual privacy"
      },
      "quasi_identifier": {
        "method": "generalize",
        "preserveFormat": true,
        "description": "Generalize quasi-identifiers to reduce re-identification risk"
      },
      "sensitive": {
        "method": "suppress",
        "preserveFormat": false,
        "description": "Suppress sensitive fields entirely for maximum protection"
      }
    }
  }
}
