{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cornyhorse/forklift/schema-standards/20250826-sql.json",
  "title": "Forklift SQL Input - One Schema Per Table Schema Standard",
  "description": "Schema for SQL database processing with simplified one-to-one schema/table mapping. Each table is explicitly specified with its schema and table name, eliminating glob patterns and making configuration predictable.",
  "type": "object",
  "properties": {
    "x-sql": {
      "type": "object",
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "select": {
                "type": "object",
                "properties": {
                  "schema": {
                    "type": "string",
                    "description": "Database schema name (e.g., 'public', 'sales', 'main'). Use 'default' or omit for default schema."
                  },
                  "name": {
                    "type": "string",
                    "description": "Exact table name to import"
                  }
                },
                "required": ["name"],
                "additionalProperties": false
              },
              "outputName": {
                "type": "string",
                "description": "Optional custom name for the output parquet file (without extension). If omitted, uses 'schema_tablename' or just 'tablename' if no schema."
              },
              "columns": {
                "type": "object",
                "description": "Per-table column schema with Parquet type mapping: each property is a column with standard JSON Schema spec and parquetType.",
                "properties": {
                  "id": { "type": "integer", "minimum": 1, "parquetType": "int64" },
                  "name": { "type": "string", "minLength": 1, "parquetType": "string" },
                  "age": { "type": "integer", "minimum": 0, "maximum": 150, "parquetType": "int32" },
                  "salary": { "type": "number", "minimum": 0, "parquetType": "double" },
                  "is_active": { "type": "boolean", "parquetType": "bool" },
                  "birth_date": { "type": "string", "format": "date", "parquetType": "date32" },
                  "created_timestamp": { "type": "string", "format": "date-time", "parquetType": "timestamp[us]" },
                  "duration_seconds": { "type": "integer", "minimum": 0, "parquetType": "duration[s]" },
                  "score": { "type": "number", "multipleOf": 0.01, "parquetType": "float32" },
                  "category": { "type": "string", "enum": ["A", "B", "C"], "parquetType": "dictionary<values=string, indices=int32>" },
                  "tags": { "type": "array", "items": { "type": "string" }, "parquetType": "list<string>" },
                  "metadata": { "type": "object", "additionalProperties": true, "parquetType": "struct" },
                  "binary_data": { "type": "string", "contentEncoding": "base64", "parquetType": "binary" },
                  "uuid": { "type": "string", "format": "uuid", "parquetType": "string" },
                  "decimal_amount": { "type": "string", "pattern": "^\\d+\\.\\d{2}$", "parquetType": "decimal128(10,2)" }
                },
                "additionalProperties": { "type": "object" }
              },
              "required": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Columns required for this specific table."
              }
            },
            "required": ["select"],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "List of tables to import. Each table must be explicitly specified with schema and table name."
        },
        "parquetTypeMapping": {
          "type": "object",
          "description": "SQL to Parquet type mapping reference for all supported data types.",
          "properties": {
            "sqlToParquet": {
              "type": "object",
              "properties": {
                "INTEGER": "int64",
                "BIGINT": "int64",
                "SMALLINT": "int32",
                "TINYINT": "int8",
                "DECIMAL": "decimal128(precision,scale)",
                "NUMERIC": "decimal128(precision,scale)",
                "FLOAT": "float32",
                "DOUBLE": "double",
                "REAL": "float32",
                "BOOLEAN": "bool",
                "VARCHAR": "string",
                "TEXT": "string",
                "CHAR": "string",
                "DATE": "date32",
                "TIMESTAMP": "timestamp[us]",
                "DATETIME": "timestamp[us]",
                "TIME": "duration[us]",
                "INTERVAL": "duration[us]",
                "BINARY": "binary",
                "VARBINARY": "binary",
                "BLOB": "binary",
                "ARRAY": "list<type>",
                "JSON": "struct",
                "UUID": "string"
              }
            }
          }
        }
      },
      "required": ["tables"],
      "additionalProperties": false
    },
    "x-calculatedColumns": {
      "description": "Configuration for adding calculated columns including constants, expressions, and computed fields",
      "constants": [
        {
          "name": "data_source",
          "value": "sql_query",
          "dataType": "string",
          "description": "Source identifier for data lineage and partitioning"
        },
        {
          "name": "load_date",
          "value": "2024-08-26",
          "dataType": "date32",
          "description": "Date when data was loaded for temporal partitioning"
        },
        {
          "name": "query_version",
          "value": "v1.0",
          "dataType": "string",
          "description": "SQL query version for change tracking"
        }
      ],
      "expressions": [
        {
          "name": "full_employee_name",
          "expression": "first_name + ' ' + last_name",
          "dataType": "string",
          "dependencies": ["first_name", "last_name"],
          "description": "Concatenated full name from first and last name fields"
        },
        {
          "name": "salary_grade",
          "expression": "CASE WHEN salary < 50000 THEN 'Grade_1' WHEN salary < 100000 THEN 'Grade_2' ELSE 'Grade_3' END",
          "dataType": "string",
          "dependencies": ["salary"],
          "description": "Salary grade classification for HR reporting"
        }
      ],
      "calculated": [
        {
          "name": "tenure_years",
          "function": "years_from_timestamp",
          "dependencies": ["hire_date"],
          "dataType": "int32",
          "description": "Employee tenure in years calculated from hire date"
        },
        {
          "name": "email_domain",
          "function": "extract_email_domain",
          "dependencies": ["email"],
          "dataType": "string",
          "description": "Domain part extracted from email address"
        }
      ],
      "partitionColumns": ["data_source", "load_date", "department"],
      "indexColumns": ["employee_id", "department", "salary_grade"],
      "options": {
        "skipIfExists": false,
        "validateDependencies": true,
        "allowNullDependencies": true
      }
    }
  },
  "required": ["x-sql"],
  "additionalProperties": false,
  "examples": [
    {
      "x-sql": {
        "tables": [
          {
            "select": {
              "schema": "public",
              "name": "users"
            },
            "outputName": "users_data",
            "columns": {
              "id": { "type": "integer", "parquetType": "int64" },
              "name": { "type": "string", "parquetType": "string" },
              "email": { "type": "string", "format": "email", "parquetType": "string" },
              "created_at": { "type": "string", "format": "date-time", "parquetType": "timestamp[us]" }
            },
            "required": ["id", "name"]
          },
          {
            "select": {
              "schema": "sales",
              "name": "orders"
            },
            "columns": {
              "order_id": { "type": "integer", "parquetType": "int64" },
              "customer_id": { "type": "integer", "parquetType": "int64" },
              "amount": { "type": "number", "parquetType": "decimal128(10,2)" },
              "order_date": { "type": "string", "format": "date", "parquetType": "date32" }
            }
          },
          {
            "select": {
              "name": "products"
            },
            "columns": {
              "product_id": { "type": "integer", "parquetType": "int64" },
              "name": { "type": "string", "parquetType": "string" },
              "price": { "type": "number", "parquetType": "double" }
            }
          }
        ]
      }
    }
  ]
}
